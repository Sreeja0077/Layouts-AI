# Application Environment Settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=supersecret-dev-key-change-in-production

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://layouts_user:layouts_password@localhost:5432/layouts_db

# Redis (Cache & Celery Result Backend)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Celery Broker)
RABBITMQ_URL=amqp://layouts_mq:layouts_mq_password@localhost:5672//

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=layouts-storage

# AI Gateway / Ollama Cloud via LiteLLM
LITELLM_GATEWAY_URL=http://localhost:4000
MODEL_FAST_ALIAS=ollama/llama3.2:3b
MODEL_REASONING_ALIAS=ollama/qwen2.5-coder:32b
MODEL_VISION_ALIAS=ollama/llava:13b

# OIDC / Keycloak Settings
OIDC_ISSUER=http://localhost:8080/realms/layouts
OIDC_CLIENT_ID=layouts-app
