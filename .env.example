# Application Environment Settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=supersecret-dev-key-change-in-production

# PostgreSQL + PostGIS Connection (with automatic SQLite fallback for local development)
DATABASE_URL=postgresql+psycopg2://layouts_user:layouts_password@localhost:5432/layouts_db
DATABASE_FALLBACK_URL=sqlite:///./layouts_ai.db

# Redis (Cache & Celery Result Backend)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Celery Broker)
RABBITMQ_URL=amqp://layouts_mq:layouts_mq_password@localhost:5672//

# ============================================================
# OMA Cloud AI Gateway
# ============================================================

OMA_API_KEY=your_oma_api_key_here
OMA_BASE_URL=https://oma.novelinfra.com

# ============================================================
# Default Model
# ============================================================

OMA_MODEL_DEFAULT=glm-5.1-cloud

# ============================================================
# Task-Specific AI Models
# ============================================================

# Requirement understanding / specification / ambiguity
OMA_MODEL_SPEC=glm-5.2-cloud

# Layout strategy reasoning
OMA_MODEL_LAYOUT=glm-5.2-cloud

# Natural-language layout modification
OMA_MODEL_CHANGE=glm-5.2-cloud

# Candidate explanation / summaries
OMA_MODEL_EXPLAIN=glm-5.1-cloud

# OCR
OMA_MODEL_OCR=glm-ocr-latest

# Vision
OMA_MODEL_VISION=glm-5.1-cloud

# Code generation
OMA_MODEL_CODE=kimi-k2.7-code-cloud

# ============================================================
# Runtime
# ============================================================

LLM_TEMPERATURE=0
USE_MOCK_LLM=false

# ============================================================
# LangGraph
# ============================================================

CHECKPOINT_BACKEND=memory

# OIDC / Keycloak Settings
OIDC_ISSUER=http://localhost:8080/realms/layouts
OIDC_CLIENT_ID=layouts-app
